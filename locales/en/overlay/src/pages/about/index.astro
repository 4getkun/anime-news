---
import Base from "../../layouts/Base.astro";
import FeedList from "../../components/FeedList.astro";
import { feedStatus, feeds, categories, topicCategories, thresholds, kindLabels, generatedAt, formatDateTime, allNews, dedupeStats, calendar, workPages } from "../../lib/news";
import { withBase } from "../../lib/url";
import { breadcrumb } from "../../lib/seo";
import type { FeedKind } from "../../lib/news";

const kinds = Object.keys(kindLabels) as FeedKind[];
const statusById = new Map(feedStatus.map((f) => [f.id, f]));
const merged = allNews.filter((it) => it.sources.length > 1).length;
---

<Base jsonLd={breadcrumb([{ name: "Sources and filtering", path: "/about/" }])} title="Sources and filtering" description="How anime news is collected and filtered, and how to customize your reading.">
  <article class="wrap prose">
    <h1>Sources and filtering</h1>
    <p>
      This site collects anime-related RSS feeds and filters out unrelated articles.
      Only headlines, short summaries and links are shown. Read full articles at their original sources. Japanese content is not translated.
      Last updated: <strong>{formatDateTime(generatedAt)}</strong>. Currently showing <strong>{allNews.length} articles</strong>,
      including <strong>{merged} stories</strong> that combine coverage from multiple sources.
    </p>

    <h2>Two stages of filtering</h2>
    <p>
      Collection filters automatically identify anime-related articles. Display filters let you choose what you want to read.
    </p>

    <h3>Collection filters (hourly, server-side)</h3>
    <ol class="pipeline">
      <li>
        <div>
          <b>Anime relevance score</b>
          Weighted terms such as TV anime, voice actors and key visuals contribute to a relevance score, with thresholds for each source type.
          Terms in headlines count twice as much as terms appearing only in summaries. Misleading terms such as anime-style or drama lead are penalized.
          Titles extracted from specialist headlines receive a bonus, helping identify related merchandise stories from general publications.
        </div>
      </li>
      <li><div><b>Category tagging</b>Articles can receive several of the {categories.length} categories, such as new titles, broadcasts, trailers and cast announcements.</div></li>
      <li><div><b>Title extraction</b>Titles are extracted from Japanese headline quotation marks and normalized by removing prefixes or season labels.</div></li>
      <li><div><b>Spoiler detection</b>Headlines mentioning finales or episode numbers are marked and can be blurred.</div></li>
      <li>
        <div>
          <b>Grouping republished articles</b>
          Republished articles from portals such as Yahoo! News, dmenu and Excite are grouped with originals when headlines match exactly or are similar within 72 hours. They are listed as republished coverage.
          When no original is found, the republished article remains with the original publication and portal names.
        </div>
      </li>
      <li>
        <div>
          <b>Grouping related coverage</b>
          Similar headlines published within 12 hours are grouped as coverage of the same announcement.
          For stories about the same title, the title is removed before comparison so that unrelated announcements are not merged.
          Each article must also resemble the first article in the group, preventing chains of weak similarities from merging unrelated coverage.
        </div>
      </li>
    </ol>
    {dedupeStats && (
      <p>
        In the latest update, <strong>{dedupeStats.exact}</strong> exact headline matches and <strong>{dedupeStats.syndicated}</strong> republished articles
        were grouped, along with <strong>{dedupeStats.similar}</strong> similar headlines.
      </p>
    )}

    <div class="table-scroll">
      <table>
        <thead><tr><th>Source type</th><th class="num">Acceptance threshold</th><th>Rationale</th></tr></thead>
        <tbody>
          {kinds.map((k) => (
            <tr>
              <td><span class={`kind-mark kind-${k}`} style="display:inline-block; margin-right:6px;"></span>{kindLabels[k]}</td>
              <td class="num">{k === "specialist" ? "None" : thresholds[k]}</td>
              <td>
                {{
                  specialist: "Accept unless excluded by a specific rule",
                  aggregator: "Lower threshold because search terms already narrow the results",
                  general: "Higher threshold for broad gaming and entertainment coverage",
                  press: "Highest threshold for a large, mixed volume of releases",
                }[k]}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      Rules are in <code>src/data/filters.json</code>; sources are in <code>src/data/feeds.json</code>.
      Raw RSS is retained separately for 30 days. Rule changes are reapplied to that history on the next update.
    </p>

    <h3>Display filters (in your browser)</h3>
    <ul>
      <li><strong>Keywords</strong>: Space-separated words must all match. Use <code>-word</code> to exclude a word. Press <code>/</code> to focus search.</li>
      <li><strong>Article language</strong>: Japanese articles appear by default. Choose All or English to include English articles. Interface language does not translate article content.</li>
      <li><strong>Category, time range, sort order and title</strong>: Filters are included in the URL for sharing.</li>
      <li><strong>Follow titles</strong>: Tap a title and choose Follow to highlight its articles in yellow or show only followed titles.</li>
      <li><strong>Mute</strong>: Hide articles containing your muted words.</li>
      <li>
        <strong>Hide unwanted topics</strong>: Hide incidents and disputes, relationships and marriage, or obituaries. All are visible by default.
        Only headlines are checked; words inside Japanese quotation marks are ignored. These sensitive topics are excluded from the home-page ticker and latest-story feature from the start.
      </li>
      <li><strong>Read status</strong>: Opened articles appear faded. Use Hide read articles to remove them from the list.</li>
      <li><strong>Most covered</strong>: Sort by the number of independently reporting publications, excluding republished copies.</li>
    </ul>
    <p>Follow, mute and read-status settings are stored only in your browser.</p>

    <h2>New stories, schedules and title pages</h2>
    <ul>
      <li>
        <strong>New since last visit</strong>: Articles collected since your previous visit receive a NEW marker. Use the matching filter to show only those articles.
        Reloading during the same visit does not clear the markers. Your last-visit time is stored only in your browser.
      </li>
      <li>
        <strong><a href={withBase("/calendar/")}>Schedule</a></strong>: Dates from headlines are listed for broadcasts, streaming, releases and events ({calendar.length} entries).
        Missing years are inferred from article dates. Deadlines, trailer releases and weekly episode announcements are excluded.
      </li>
      <li>
        <strong><a href={withBase("/work/")}>Title pages</a></strong>: Articles and schedules are collected for titles appearing in at least two articles within 30 days ({workPages.length} titles).
      </li>
    </ul>

    <h2>Read via RSS</h2>
    <p>Subscribe using your RSS reader. Each feed contains the 50 newest Japanese articles. Feedly and Inoreader buttons open subscription screens; for other readers, copy and paste the feed URL.</p>
    <FeedList
      feeds={[
          { label: "All articles", path: withBase("/feed.xml") },
          ...topicCategories.map((c) => ({ label: c.label, path: withBase(`/feed/${c.id}.xml`) })),
        ]}
    />

    <h2>Sources collected</h2>
    <div class="table-scroll">
      <table>
        <thead>
          <tr><th>Sources</th><th>Type</th><th class="num">Fetched this run</th><th class="num">Past 30 days</th><th class="num">Accepted</th></tr>
        </thead>
        <tbody>
          {feeds.map((f) => {
            const s = statusById.get(f.id);
            return (
              <tr>
                <td>{f.name}{f.lang === "en" && " (English)"}</td>
                <td><span class={`kind-mark kind-${f.kind}`} style="display:inline-block; margin-right:6px;"></span>{kindLabels[f.kind]}</td>
                <td class="num">{s ? (s.ok ? s.fetched : <span class="status-ng">Fetch failed</span>) : "-"}</td>
                <td class="num">{s?.archived ?? "-"}</td>
                <td class="num">{s?.accepted ?? "-"}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="fine-print">Articles marked as advertising or sponsored content by their sources, adult content and recruitment posts are excluded.</p>
  </article>
</Base>

